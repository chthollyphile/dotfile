#!/bin/bash

# Sets the specified image as the current background

if [[ -z $1 ]]; then
  echo "Usage: omarchy-theme-bg-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$1"
CURRENT_BACKGROUND_LINK="$HOME/.config/omarchy/current/background"

CURRENT_BACKGROUND_LOCK_LINK="$HOME/.config/omarchy/current/background-lock"

# Create symlink to the new background
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Create symlink for lock screen
if [[ "${BACKGROUND,,}" == *.gif ]]; then
  if [[ -f "${BACKGROUND%.*}.lock.png" ]]; then
    ln -nsf "${BACKGROUND%.*}.lock.png" "$CURRENT_BACKGROUND_LOCK_LINK"
  elif [[ -f "${BACKGROUND%.*}.lock.jpg" ]]; then
    ln -nsf "${BACKGROUND%.*}.lock.jpg" "$CURRENT_BACKGROUND_LOCK_LINK"
  else
    ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LOCK_LINK"
  fi
else
  ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LOCK_LINK"
fi

# Kill existing swaybg and start new one
pkill -x swaybg
setsid uwsm-app -- swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &
