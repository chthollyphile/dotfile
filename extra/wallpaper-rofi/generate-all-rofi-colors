#!/bin/bash

# --- 1. 定义所有包含主题的根目录 ---
THEME_ROOTS=(
    "/home/lia/.config/omarchy/themes"
    "/home/lia/.local/share/omarchy/themes"
)

# --- 2. 核心处理逻辑 ---
for root in "${THEME_ROOTS[@]}"; do
    echo "====================================================="
    echo "正在扫描目录: $root"
    
    if [[ ! -d "$root" ]]; then
        echo "⚠️  跳过 (目录不存在): $root"
        continue
    fi

    # 遍历该根目录下的所有一级子目录
    find "$root" -mindepth 1 -maxdepth 1 -type d | while read -r theme_dir; do
        
        theme_name=$(basename "$theme_dir")
        COLORS_TOML="$theme_dir/colors.toml"
        ALACRITTY_TOML="$theme_dir/alacritty.toml"
        TARGET_FILE="$theme_dir/colors.rasi"

        if [[ -f "$COLORS_TOML" ]]; then
            # --- 新格式: colors.toml (扁平 key=value) ---
            awk '
            BEGIN {
                print "/* 自动生成自 " theme " 的 colors.toml */"
                print "* {"
            }
            /=/ {
                gsub(/^[ \t]+|[ \t]+$/, "")
                split($0, arr, "=")
                key = arr[1]
                gsub(/[ \t]/, "", key)
                val = arr[2]
                gsub(/[ "\047]/, "", val)

                if (key == "background")  print "    background: " val ";"
                if (key == "foreground")  print "    foreground: " val ";"
                if (key ~ /^color[0-9]+$/) {
                    # 对齐: color0~color9 补一个空格
                    if (length(key) == 6)
                        printf "    %s:  %s;\n", key, val
                    else
                        printf "    %s: %s;\n", key, val
                }
            }
            END {
                print "}"
            }
            ' theme="$theme_name" "$COLORS_TOML" > "$TARGET_FILE"

            echo -e "✅ [$theme_name] \t-> 已生成 (colors.toml)"

        elif [[ -f "$ALACRITTY_TOML" ]]; then
            # --- 旧格式: alacritty.toml (分段式, 向后兼容) ---
            awk '
            BEGIN {
                print "/* 自动生成自 " theme " 的 alacritty.toml */"
                print "* {"
                section = ""
            }
            /^\[.*\]/ {
                gsub(/[\[\]]/, "", $0)
                section = $0
                next
            }
            /=/ {
                gsub(/^[ \t]+|[ \t]+$/, "")
                split($0, arr, "=")
                key = arr[1]
                gsub(/[ \t]/, "", key)
                val = arr[2]
                gsub(/[ "\047]/, "", val)

                if (section == "colors.primary") {
                    if (key == "background") print "    background: " val ";"
                    if (key == "foreground") print "    foreground: " val ";"
                }
                if (section == "colors.normal") {
                    if (key == "black")   print "    color0: " val ";"
                    if (key == "red")     print "    color1: " val ";"
                    if (key == "green")   print "    color2: " val ";"
                    if (key == "yellow")  print "    color3: " val ";"
                    if (key == "blue")    print "    color4: " val ";"
                    if (key == "magenta") print "    color5: " val ";"
                    if (key == "cyan")    print "    color6: " val ";"
                    if (key == "white")   print "    color7: " val ";"
                }
                if (section == "colors.bright") {
                    if (key == "black")   print "    color8:  " val ";"
                    if (key == "red")     print "    color9:  " val ";"
                    if (key == "green")   print "    color10: " val ";"
                    if (key == "yellow")  print "    color11: " val ";"
                    if (key == "blue")    print "    color12: " val ";"
                    if (key == "magenta") print "    color13: " val ";"
                    if (key == "cyan")    print "    color14: " val ";"
                    if (key == "white")   print "    color15: " val ";"
                }
            }
            END {
                print "}"
            }
            ' theme="$theme_name" "$ALACRITTY_TOML" > "$TARGET_FILE"

            echo -e "✅ [$theme_name] \t-> 已生成 (alacritty.toml)"
        fi
    done
done

echo "====================================================="
echo "所有主题配色生成完毕。"
